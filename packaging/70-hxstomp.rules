# Line 6 HX Stomp / HX Stomp XL — let the logged-in local user claim the vendor
# USB control interface. systemd's default uaccess only tags /dev/snd/*, not this
# raw USB node, so without this rule you get EACCES (and must run as root).
#
# Install with `fretwire install-udev`, or copy this file to
# /etc/udev/rules.d/70-hxstomp.rules and run:
#   sudo udevadm control --reload && sudo udevadm trigger
# Then unplug and replug the device.
#
# idVendor/idProduct must be lower-case hex to match.
SUBSYSTEM=="usb", ATTR{idVendor}=="0e41", ATTR{idProduct}=="4246", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="0e41", ATTR{idProduct}=="4253", MODE="0660", TAG+="uaccess"
