# Maintainer: John Baxter <john-baxter-dev@proton.me>
#
# Arch package for fretwire — builds from a release tag. Ships no Line 6 data: the app imports the
# model catalogue from the user's own HX Edit (or POD Go Edit) installation on first run
# (`fretwire import-data`, or the GUI's first-run screen).
#
# Per release: bump pkgver, reset pkgrel=1, `updpkgsums`, `makepkg --printsrcinfo > .SRCINFO`,
# then commit + push to ssh://aur@aur.archlinux.org/fretwire.git. Validate with `makepkg -si`
# from a copy outside this repo (makepkg litters src/ and pkg/).

pkgname=fretwire
pkgver=0.5.1
pkgrel=1
pkgdesc="Independent editor for Line 6 HX, Helix and POD Go devices"
arch=('x86_64')
url="https://github.com/john-baxter-dev/fretwire"
license=('MIT' 'Apache-2.0')
depends=('webkit2gtk-4.1' 'gtk3')
# makepkg's `lto` option puts `-flto=auto` into CFLAGS, so the C in `ring` (TLS for the update
# check) comes out as GCC LTO bitcode that rust-lld cannot link: "undefined symbol:
# ring_core_0_17_14__LIMBS_window5_split_window". Rust does its own LTO from Cargo.toml.
options=('!lto')
makedepends=('cargo' 'npm' 'pkgconf')
optdepends=('p7zip: unpack an HX Edit installer during `fretwire import-data`')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# SKIP until the v0.5.1 tag exists on GitHub — then `updpkgsums` (CI builds from the checkout and
# skips this; the AUR copy must carry the real hash).
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked
  # The Rust crate embeds the built frontend, which isn't in the source tree.
  cd crates/fretwire-tauri/ui
  npm ci
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  ( cd crates/fretwire-tauri/ui && npm run build )
  cargo build --release --frozen -p fretwire-cli -p fretwire-tauri
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # Offline suite only — the data-gated tests compile out without the reference data, and nothing
  # here touches hardware.
  cargo test --release --frozen -p fretwire-data -p fretwire-protocol -p fretwire-core \
    -p fretwire-commands -p fretwire-cli
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm0755 target/release/fretwire "$pkgdir/usr/bin/fretwire"
  install -Dm0755 target/release/fretwire-gui "$pkgdir/usr/bin/fretwire-gui"

  # Non-root access to the pedal's USB control interface. Users still need to replug after install.
  install -Dm0644 packaging/70-hxstomp.rules "$pkgdir/usr/lib/udev/rules.d/70-hxstomp.rules"

  install -Dm0644 crates/fretwire-tauri/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/fretwire.png"
  install -Dm0644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm0644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"

  install -Dm0644 /dev/stdin "$pkgdir/usr/share/applications/fretwire.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=fretwire
GenericName=Line 6 HX Editor
Comment=Edit presets on a Line 6 HX Stomp, Helix or POD Go
Exec=fretwire-gui
Icon=fretwire
Categories=AudioVideo;Audio;Music;
Terminal=false
EOF
}
