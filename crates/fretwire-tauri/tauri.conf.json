{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fretwire",
  "identifier": "com.fretwire.app",
  "build": {
    "frontendDist": "./dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "cwd": "ui",
      "script": "npm run dev"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "fretwire",
        "width": 1360,
        "height": 860,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Music",
    "shortDescription": "Editor for the Line 6 HX Stomp",
    "longDescription": "An independent editor for the Line 6 HX Stomp on Linux. Browse and edit presets, blocks, parameters and snapshots over the pedal's USB control interface. Ships no Line 6 data — the model catalogue is imported from your own HX Edit installation on first run.",
    "licenseFile": "../../LICENSE-MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-hxstomp.rules": "../../packaging/70-hxstomp.rules",
          "/usr/bin/fretwire": "../../target/release/fretwire"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/70-hxstomp.rules": "../../packaging/70-hxstomp.rules",
          "/usr/bin/fretwire": "../../target/release/fretwire"
        }
      }
    },
    "publisher": "John Baxter",
    "homepage": "https://fretwire.org"
  }
}
